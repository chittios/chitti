/target
/kernel/target
/xtask/target
target/
.DS_Store
assets/voice/
assets/wifi/

__pycache__/
# e2e test-generated TLS certs
tests/e2e/certs/

.idea/
# Full 16 MB Noto Sans CJK — NOT used (a ~1.7 MB subset, Noto-CJK.otf, is
# bundled instead; the full face is too big to parse in-kernel). Ignored so a
# stray download of it is never committed.
assets/fonts/NotoSansCJKsc-Regular.otf

# External conformance suites for the webcompat/JS tooling — cloned locally on
# demand, never vendored. They were once committed as bare submodule gitlinks
# with no .gitmodules, which broke `actions/checkout` (no url for submodule
# path). Keep them ignored so they can't be re-added.
tools/webcompat/test262/
tools/webcompat/wasm-testsuite/

# Apple-Silicon device tree blobs for booting via m1n1 — built on demand by
# tools/build-apple-dtb.sh from the Asahi Linux dts (GPL-2.0). Not vendored:
# the .dtb is a generated, GPL-derived artifact and the sparse-clone cache is
# large. Point CHITTI_DTB at the built file.
third_party/dtb/*.dtb
third_party/dtb/.asahi-linux/
scratchpad-agx/
