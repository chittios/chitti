/target
/kernel/target
/xtask/target
target/
target-a64/
.DS_Store
assets/voice/
assets/wifi/

# The `/samples/` corpus (images/videos/audios/misc) fetched by
# `cargo xtask sample-files` and embedded into the image when
# CHITTI_SAMPLE_FILES is set (default for `make run` / `make vbox`).
# Fetched, never committed — the same rule as the voice/WiFi assets, so the
# tree redistributes none of it; provenance + licences are recorded in the
# generated assets/samples/README.md.
assets/samples/

__pycache__/
# e2e test-generated TLS certs (regenerated at run time by run.py)
tests/e2e/certs/
# ...but the registry *signing* key must be checked in: the kernel's trust
# store bakes its public point, so the harness cannot regenerate it at runtime.
# It is a test-only key for the "chitti-publisher-test" publisher.
!tests/e2e/certs/registry-key.pem

.idea/
# Full 16 MB Noto Sans CJK — NOT used (a ~1.7 MB subset, Noto-CJK.otf, is
# bundled instead; the full face is too big to parse in-kernel). Ignored so a
# stray download of it is never committed.
assets/fonts/NotoSansCJKsc-Regular.otf

# External conformance suites for the webcompat/JS tooling — cloned locally on
# demand, never vendored. They were once committed as bare submodule gitlinks
# with no .gitmodules, which broke `actions/checkout` (no url for submodule
# path). Keep them ignored so they can't be re-added.
tools/webcompat/test262/
tools/webcompat/wasm-testsuite/

# React+Tailwind and shadcn/ui sample builds (tools/react-tw, tools/react-shadcn)
# — node_modules + vite dist; the copied artifacts under assets/samples-src/html/
# are what get embedded.
tools/react-tw/node_modules/
tools/react-tw/dist/
tools/react-shadcn/node_modules/
tools/react-shadcn/dist/
tools/react-shadcn/dist-dev/

# Host harness build output (tools/csslayout mounts the kernel's own modules).
tools/csslayout/target/

# Apple-Silicon device tree blobs for booting via m1n1 — built on demand by
# tools/build-apple-dtb.sh from the Asahi Linux dts (GPL-2.0). Not vendored:
# the .dtb is a generated, GPL-derived artifact and the sparse-clone cache is
# large. Point CHITTI_DTB at the built file.
third_party/dtb/*.dtb
third_party/dtb/.asahi-linux/
scratchpad-agx/
assets/*.partial
userspace/*/target/
userspace/**/*.bin
# ...except the tenant blobs, which are **deliberately checked in** — the kernel
# `include_bytes!`s them, exactly as it does `agents/*/assets/tools.wasm`. Without them the
# tree does not build for anyone who did not run `cargo xtask imgdec` locally.
!userspace/imgdec/imgdec-*.bin

node_modules/