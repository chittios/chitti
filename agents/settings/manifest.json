{
  "name": "settings",
  "version": "1.0.0",
  "kind": "skill_agent",
  "description": "Settings panel: display resolution + prefs (tools.wasm UI).",
  "package_ui": true,
  "toolset": [
    "settings_start",
    "settings_get",
    "settings_set",
    "settings_status",
    "display",
    "statusbar"
  ],
  "capabilities": [
    {
      "domain": "ui",
      "rights": [
        "exec",
        "write",
        "delete"
      ],
      "scope": "any"
    },
    {
      "domain": "fs",
      "rights": [
        "read",
        "write",
        "list"
      ],
      "scope": "home"
    },
    {
      "domain": "todo",
      "rights": [
        "read",
        "write"
      ],
      "scope": "any"
    }
  ],
  "wasm": {
    "module": "assets/tools.wasm",
    "fuel": 2000000
  },
  "autostart": false
}
