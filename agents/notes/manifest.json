{
  "name": "notes",
  "version": "1.0.0",
  "kind": "skill_agent",
  "description": "Markdown notes in durable storage (tools.wasm UI + chat tools).",
  "package_ui": true,
  "toolset": [
    "notes_start",
    "notes_list",
    "notes_get",
    "notes_set",
    "notes_remove",
    "memory_add",
    "memory_get",
    "memory_list"
  ],
  "capabilities": [
    {"domain": "fs", "rights": ["read", "write", "list"], "scope": "home"},
    {"domain": "ui", "rights": ["exec", "write", "delete"], "scope": "any"},
    {"domain": "todo", "rights": ["read", "write"], "scope": "any"}
  ],
  "wasm": {"module": "assets/tools.wasm", "fuel": 2000000},
  "autostart": true
}
