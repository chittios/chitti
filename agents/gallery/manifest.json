{
  "name": "gallery",
  "version": "1.0.0",
  "kind": "skill_agent",
  "description": "Image gallery over durable storage (tools.wasm).",
  "toolset": [
    "gallery_start",
    "gallery_list",
    "gallery_get",
    "gallery_set",
    "gallery_status"
  ],
  "capabilities": [
    {
      "domain": "ui",
      "rights": [
        "exec",
        "write",
        "delete"
      ],
      "scope": "any"
    },
    {
      "domain": "fs",
      "rights": [
        "read",
        "write",
        "list"
      ],
      "scope": "home"
    },
    {
      "domain": "todo",
      "rights": [
        "read",
        "write"
      ],
      "scope": "any"
    }
  ],
  "wasm": {
    "module": "assets/tools.wasm",
    "fuel": 2000000
  },
  "autostart": false
}
