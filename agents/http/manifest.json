{
  "name": "http",
  "version": "1.0.0",
  "kind": "service",
  "description": "Parses HTTP/1.1 natively and serves documents; the Doc agent renders through it.",
  "toolset": ["net_accept", "channel_read", "channel_write"],
  "capabilities": [
    { "domain": "net", "rights": ["exec", "read"], "scope": "any" },
    { "domain": "channel", "rights": ["read", "write"], "scope": "any" }
  ],
  "service": "http-doc",
  "autostart": false,
  "default_port": 8080
}
