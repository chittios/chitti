{
  "name": "weather",
  "version": "1.0.0",
  "kind": "skill_agent",
  "description": "Weather card UI (tools.wasm) + HTTP fetch for live conditions.",
  "package_ui": true,
  "toolset": [
    "weather_start",
    "weather_set",
    "weather_status",
    "http",
    "memory_add",
    "emit_result"
  ],
  "capabilities": [
    {
      "domain": "ui",
      "rights": ["exec", "write", "delete"],
      "scope": "any"
    },
    {
      "domain": "fs",
      "rights": ["read", "write", "list"],
      "scope": "home"
    },
    {
      "domain": "net",
      "rights": ["read", "write"],
      "scope": "any"
    },
    {
      "domain": "todo",
      "rights": ["read", "write"],
      "scope": "any"
    }
  ],
  "wasm": {
    "module": "assets/tools.wasm",
    "fuel": 2000000
  },
  "autostart": false
}
